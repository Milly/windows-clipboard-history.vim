{
  "name": "@milly/windows-clipboard-history",
  "exports": {
    ".": "./mod.ts",
    "./clipboard-history": "./clipboard-history.ts",
    "./json": "./json.ts",
    "./time": "./time.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@~1.0.19",
    "@std/path": "jsr:@std/path@~1.1.6"
  },
  "tasks": {
    "cache": "deno install --reload",
    "check": "deno check **/*.ts && deno fmt --check **/*.ts && deno lint",
    "fmt": "deno fmt **/*.ts",
    "lint": "deno lint",
    "lint-fix": "deno lint --fix",
    "test": "deno test -A --parallel --shuffle **/*_test.ts"
  }
}
